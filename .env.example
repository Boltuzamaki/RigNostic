# Copy this file to .env and fill in the credential locally.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
RIGNOSTIC_PROVIDER=auto
# LiteLLM accepts provider/model names. Legacy Gemini names are also supported.
RIGNOSTIC_MODEL=gemini-3.5-flash-lite
DATABASE_URL=postgresql+psycopg://rignostic:rignostic@127.0.0.1:5432/rignostic
SECRET_KEY=replace-with-a-long-random-value
